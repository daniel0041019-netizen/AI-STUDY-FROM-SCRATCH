from typing import Literal
from pydantic import BaseModel, Field
from openai import OpenAI

client = OpenAI()

# 1. 백엔드 규격을 완벽히 강제하기 위한 Pydantic 데이터 모델 정의
class CodeAnalysisReport(BaseModel):
    is_secure: bool = Field(description="보안 결함 존재 여부 (True: 안전, False: 취약)")
    severity: Literal["LOW", "MEDIUM", "HIGH", "CRITICAL"] = Field(
        description="위험도 등급 (Literal로 특정 범위 강제)"
    )
    vulnerabilities: list[str] = Field(description="발견된 주요 보안 취약점 목록")
    remediation: str = Field(description="조치 및 권장 조치 사항 요약")

def run_structured_output():
    source_code = """
    def login(user_input):
        query = f"SELECT * FROM users WHERE username = '{user_input}'"
        db.execute(query)
    """

    # 2. parse() 메서드와 Pydantic 스키마 결합 (100% 스키마 및 타입 준수 강제)
    completion = client.beta.chat.completions.parse(
        model="gpt-4o",
        messages=[
            {"role": "system", "content": "제공된 파이썬 코드를 분석하고 보안 리포트를 반환하세요."},
            {"role": "user", "content": source_code}
        ],
        response_format=CodeAnalysisReport,
        temperature=0.0
    )

    # 별도의 json.loads() 파싱 과정 없이 .parsed 속성으로 수동 파싱 차단 및 즉시 객체화
    result: CodeAnalysisReport = completion.choices[0].message.parsed

    print("=== [Part 3] Structured Output (Pydantic) 결과 ===")
    print(f"보안 안전 여부: {result.is_secure}")
    print(f"위험도: {result.severity}")
    print(f"취약점: {result.vulnerabilities}")
    print(f"개선안: {result.remediation}")

if __name__ == "__main__":
    run_structured_output()
